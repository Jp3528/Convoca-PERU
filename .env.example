# Public website URL: set your real Vercel/custom domain in production
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3060
SITE_INDEXABLE=false
PORTAL_DEMO_MODE=true

# Server-only Supabase configuration. Required on Vercel.
# Run database migrations 002, 003 and 004 before enabling the production cron.
SUPABASE_URL=
# Private server key: sb_secret_ (recommended) or a legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Private editorial login. npm run setup:local generates local values.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Server-only automatic scraping. npm run setup:local generates the private key.
# Local runner checks hourly; vercel.json invokes the production route daily.
CRON_SECRET=
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_INTERVAL_MINUTES=60

# AdSense is off until an account/site review, blocks and consent are configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_APPROVED=false
NEXT_PUBLIC_ADSENSE_PREVIEW=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_OPPORTUNITY=
